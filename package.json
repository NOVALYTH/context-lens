{
  "name": "context-lens",
  "version": "0.1.0",
  "description": "Measure where your Claude Code context goes, and keep the workspace that loads automatically small.",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.5" },
  "scripts": {
    "lens": "node scripts/measure-context.mjs",
    "check": "node scripts/check-workspace.mjs",
    "check:template": "node scripts/check-workspace.mjs --root template",
    "search": "node scripts/decisions.mjs search",
    "verify": "node scripts/decisions.mjs verify",
    "test": "node --test tests/*.test.mjs"
  }
}
